# Copy to .env and adjust. All settings are optional.

# Storage (default: SQLite in ./data). For Postgres:
# ONIONLENS_DATABASE_URL=postgresql+psycopg://onionlens:onionlens@localhost:5432/onionlens
# ONIONLENS_OPENSEARCH_URL=http://localhost:9200
# ONIONLENS_REDIS_URL=redis://localhost:6379/0

# Tor SOCKS proxy (Tor Browser uses 9150, the tor daemon 9050)
ONIONLENS_TOR_PROXY=socks5://127.0.0.1:9050
ONIONLENS_CRAWL_MAX_PAGES=50
ONIONLENS_CRAWL_MAX_DEPTH=2
ONIONLENS_CRAWL_DELAY_SECONDS=3

# Analysis engines: keyword | zeroshot   /   auto | spacy | regex
ONIONLENS_CLASSIFIER=keyword
ONIONLENS_NER=auto
ONIONLENS_TRANSLATE=false

# Telegram (https://my.telegram.org)
# ONIONLENS_TELEGRAM_API_ID=
# ONIONLENS_TELEGRAM_API_HASH=

# Protect the API (sent as X-API-Key). The dashboard reads VITE_API_KEY at build time.
# ONIONLENS_API_KEY=change-me
ONIONLENS_CORS_ORIGINS=http://localhost:5173
